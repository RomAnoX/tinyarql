{
  "name": "tinyarql-editor",
  "private": true,
  "description": "Bundles CodeMirror 6 into ../../src/frontend/editor.js (npm run build) and Lucide icons into ../../src/frontend/icons.js (npm run icons). Run npm install first.",
  "scripts": {
    "build": "esbuild entry.js --bundle --minify --format=iife --target=safari15 --legal-comments=none --outfile=../../src/frontend/editor.js",
    "icons": "node icons.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@lezer/highlight": "^1.2.0",
    "@replit/codemirror-vim": "^6.4.0",
    "codemirror": "^6.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "lucide-static": "^1.59.0"
  }
}
